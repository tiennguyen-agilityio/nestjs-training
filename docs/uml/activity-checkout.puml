@startuml activity-checkout
' Checkout: from the cart to a valid order form. Signing in is asked here,
' and the device cart is merged into the user cart. Placing the order is
' its own activity (Place order).

title Checkout

|Customer|
|Coffee Shop System|

|Coffee Shop System|
start
if (Signed in?) then ([no])
  :Sign in\n(activity 1);
  :Merge the device cart\ninto the user cart;
else ([yes])
endif
:Open the checkout page\n(saved address, delivery methods, totals);

|Customer|
repeat
  :1 · Enter the shipping address\n(name, phone, address, city);
  :2 · Choose a delivery method;
  |Coffee Shop System|
  :Update the totals\n(shipping fee and tax);
  |Customer|
  :3 · Choose a payment method\n(card, PayPal or cash on delivery;\nenter its extra details if it needs any);
  :4 · Click Place order;
  |Coffee Shop System|
  :Check the form\n(address and choices);
backward :Show the errors\non the marked fields;
repeat while (Form valid?) is ([no]) not ([yes])

:Place order\n(activity 8);
stop

@enduml
