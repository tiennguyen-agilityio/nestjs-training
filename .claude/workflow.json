{
  "version": 1,
  "packageManager": "pnpm",
  "git": {
    "remote": "origin",
    "baseBranch": "develop",
    "protected": ["develop", "main"]
  },
  "tracker": {
    "type": "trello",
    "board": "https://trello.com/b/0kDr8gOc/nestjs-training",
    "lists": {
      "todo": "TODO",
      "inProgress": "IN PROGRESS",
      "review": "REVIEW",
      "done": "DONE"
    }
  },
  "autofix": "lint-staged",
  "specsDir": "docs/specs",
  "apps": {
    "api": {
      "dir": "apps/api",
      "runner": "Vitest",
      "coverage": "pnpm run test:cov --coverage.reporter=json-summary --coverage.reporter=text-summary",
      "e2e": true,
      "planChanges": [
        "an endpoint or request/response shape",
        "an entity or migration"
      ],
      "security": [
        "src/common/guards/",
        "src/common/decorators/",
        "src/common/middlewares/",
        "src/common/providers/",
        "src/modules/webhook/",
        "src/configs/",
        "src/app.module.ts",
        "src/main.ts",
        "Dockerfile",
        "docker-compose.yml",
        "docker-compose.dev.yml"
      ],
      "ui": []
    },
    "web": {
      "dir": "apps/web",
      "runner": "Jest",
      "coverage": "pnpm run test:cov --coverageReporters=json-summary --coverageReporters=text-summary",
      "e2e": false,
      "planChanges": [
        "a route or page added or removed",
        "the src/middleware.ts matcher",
        "the apiClient/service result contract"
      ],
      "security": [
        "src/middleware.ts",
        "src/services/api.ts",
        "src/utils/api.ts",
        "src/providers/AuthTokenBridge.tsx",
        "src/components/RedirectCallback/",
        "next.config.ts",
        "vercel.json"
      ],
      "ui": [
        "src/{app,components,sections,layouts,theme}/**",
        "public/**",
        "tailwind.config.ts"
      ],
      "screenshot": {
        "dir": "docs/images/{feature}",
        "format": "png",
        "themeStorageKey": "node-brew-theme",
        "devCommand": "pnpm --filter web dev",
        "url": "http://localhost:3001",
        "cookies": [{ "name": "sidebar_state", "value": "true" }],
        "readyCheck": { "absentSelector": ".animate-pulse", "settleMs": 2000 },
        "removeSelectors": ["nextjs-portal"]
      }
    }
  },
  "shared": [
    "packages/constants",
    "packages/schemas",
    "packages/eslint-config",
    "packages/prettier-config",
    "packages/typescript-config",
    "pnpm-workspace.yaml"
  ]
}
